import proto "valueWithUncertainty.proto";

extend value_with_uncertainty {
  fn Add(right:value_with_uncertainty) -> value_with_uncertainty{
    var newValue : double = value + right.value;
    var upperUncert : double = positive_uncertainty + right.positive_uncertainty; //always the case
    if(right.symmetric && symmetric){
        return new value_with_uncertainty{
          positive_uncertainty: upperUncert,
          negative_uncertainty:0, //ignored
          symmetric: true,
          value: newValue
        };
    }

    var lowerUncert : double = negative_uncertainty;      
      //no longer symmetric, fall through to return b
      if(symmetric){
        //right is ace
        lowerUncert = right.negative_uncertainty + positive_uncertainty;
      }
      else{
        //left is ace, so lowerUncert just needs addition
        if(right.symmetric){        
        lowerUncert += right.positive_uncertainty;
      }
      else{
        //both ace
        lowerUncert += right.negative_uncertainty;
      }
    }  

    var b :value_with_uncertainty = new value_with_uncertainty{
      positive_uncertainty: upperUncert,
      negative_uncertainty: lowerUncert,
      symmetric: lowerUncert == upperUncert,
      value: newValue
    };
    return b;
  }

  fn Subtract(right:value_with_uncertainty)-> value_with_uncertainty{
      var leftUpper = positive_uncertainty;
      var leftLower = positive_uncertainty;
      if(!symmetric){
        leftLower = negative_uncertainty;
      }
      var rightUpper = right.positive_uncertainty;
      var rightLower = right.positive_uncertainty;
      if(!right.symmetric){
        rightLower = right.negative_uncertainty;
      }
      var upperUncert = leftUpper + rightLower;
      var lowerUncert = leftLower + rightUpper;

      return new value_with_uncertainty{
      positive_uncertainty: upperUncert,
      negative_uncertainty: lowerUncert ,
      symmetric: lowerUncert == upperUncert,
      value: value - right.value,
    };
  }

  fn AddDouble(right: double) -> value_with_uncertainty{
    return Add(new value_with_uncertainty{
      value: right,
      symmetric: true,
      positive_uncertainty:0
    });
  }

    fn SubtractDouble(right: double) -> value_with_uncertainty{
    return Subtract(new value_with_uncertainty{
      value: right,
      symmetric: true,
      positive_uncertainty:0
    });
  }
}




factory value_with_uncertainty {
    fn create_symmetric(value:double, uncertainty: double) -> value_with_uncertainty {
        //We're ignoring negative uncertainty checks for now
      var result: value_with_uncertainty = new value_with_uncertainty {
        value: value,
        positive_uncertainty: uncertainty,
        symmetric: true,
      };
      
      return result;
    }
    fn create_asymmetric(value:double, positive: double, negative: double) -> value_with_uncertainty {
      //We're ignoring negative uncertainty checks for now
      var result: value_with_uncertainty = new value_with_uncertainty {
        value: value,
        positive_uncertainty: positive,
        negative_uncertainty: negative,
        symmetric: false,
      };
      
      return result;
    }
}
